# GCP project that owns Vertex AI RAG resources (must exist, Vertex AI API enabled, billing linked).
# 403 BILLING_DISABLED → link a billing account to this project in Cloud Console, then retry.
# 403 CONSUMER_INVALID → wrong project ID, no access, or API not enabled for this project.
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="True"

# Local RAG (ChromaDB): set to 1 to skip Vertex RAG APIs; corpora live under LOCAL_RAG_DATA_DIR.
# Required for Docker/Cloud Run deployment in DEPLOY.md.
USE_LOCAL_RAG=1
# LOCAL_RAG_DATA_DIR=/data/local_rag
