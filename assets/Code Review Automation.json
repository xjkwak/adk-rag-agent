    {
      "parameters": {
        "jsCode": "// Este código toma todos los comentarios recibidos y se queda solo con el más reciente\nconst allComments = $input.all();\nif (allComments.length === 0) return { error: \"No se encontraron comentarios\" };\n\n// Tomamos el último de la lista\nconst latestComment = allComments[allComments.length - 1];\n\nreturn {\n  code_snippet: latestComment.json.body\n};"
      },
      "type": "n8n-nodes-base.code",
