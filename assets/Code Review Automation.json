    {
      "parameters": {
        "jsCode": "try {\n  // 1. Obtenemos la salida del agente\n  let text = $json.output;\n\n  // 2. Extraemos el JSON (limpiamos si trae bloques de código ```json)\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (!jsonMatch) throw new Error(\"No se encontró JSON\");\n  \n  const data = JSON.parse(jsonMatch[0]);\n\n  // 3. Extraemos el status para el nodo IF\n  const status = (data.alignment_status || 'Needs Revision').trim();\n  const statusEmoji = status === 'Approved' ? '✅' : '⚠️';\n  const score = data.analysis_score || 'N/A';\n\n  // 4. Construimos el mensaje en Markdown compatible con Jira\n  let message = `*Agent QA supervisor:* Hi, after my initial review my comments are:\\n\\n`;\n\n  message += `*${statusEmoji} AUDIT SUMMARY*\\n`;\n  message += `_________________________________\\n`;\n  message += `* *Score:* ${score}/100\\n`;\n  message += `* *Status:* *${status.toUpperCase()}*\\n\\n`;\n\n  message += `*📝 EXECUTIVE SUMMARY*\\n`;\n  message += `${data.executive_summary || 'No summary.'}\\n\\n`;\n\n  message += `*🎯 BUSINESS GAP*\\n`;\n  message += `${data.business_gap || 'None.'}\\n\\n`;\n\n  // 5. Hallazgos técnicos\n  if (data.technical_findings && data.technical_findings.length > 0) {\n      message += `*🛠 TECHNICAL FINDINGS*\\n`;\n      data.technical_findings.forEach((finding) => {\n          const sev = finding.severity || 'Low';\n          const severityIcon = sev === 'High' ? '🔴' : (sev === 'Medium' ? '🟠' : '🟡');\n          message += `* *${severityIcon} ${finding.issue}* (Sev: ${sev})\\n`;\n          message += `** _Fix:_ ${finding.suggested_fix}\\n`;\n      });\n  } else {\n      message += `*✅ No technical issues found.*\\n`;\n  }\n\n  message += `\\n_________________________________\\n`;\n  message += `🚀 _Sent by Aegis Intelligence System_`;\n\n  // 6. Retornamos ambos campos\n  return { \n    jira_markdown: message, \n    status: status // ESTE es el que conectas al nodo IF\n  };\n\n} catch (error) {\n  return { \n    jira_markdown: \"⚠️ *Error:* \" + error.message,\n    status: \"Error\"\n  };\n}"
      },
