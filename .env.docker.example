# Optional overrides for docker compose (not committed).
# cp .env.docker.example .env.docker
#
# By default, Compose loads knowledge_hub/.env (last wins over this file).
# Do NOT leave GOOGLE_CLOUD_PROJECT=your-gcp-project-id in .env.docker — that
# placeholder causes 403 CONSUMER_INVALID from Vertex.

# GOOGLE_CLOUD_PROJECT=knowledge-hub-495919
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=True
# USE_LOCAL_RAG=1

# Optional: override ADC path on host (default: ~/.config/gcloud/application_default_credentials.json)
# GCLOUD_ADC_FILE=/path/to/application_default_credentials.json
